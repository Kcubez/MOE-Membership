{
  "info": {
    "name": "MOE Meetup Sessions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Writes real data: use a development database. Set credentials locally, choose an available planId and enabled staffId, and enter meetupDate explicitly as YYYY-MM-DD. Staff can call GET /sessions and /sessions/:id with their own token; they never receive other staff details. Unassigned IDs return 404. Members are denied. No scanning/attendance is performed."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminPhone",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    },
    {
      "key": "meetupDate",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "sessionVersion",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Admin sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{adminPhone}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"authToken\",data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create meetup \u2014 choose plan, staff and date first",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman meetup\",\n  \"planId\": \"{{planId}}\",\n  \"meetupDate\": \"{{meetupDate}}\",\n  \"open\": false,\n  \"staffIds\": [\n    \"{{staffId}}\"\n  ],\n  \"reason\": \"Manual meetup creation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"sessionId\",data.id); pm.collectionVariables.set(\"sessionVersion\",data.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List visible sessions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions?limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Open session",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions/{{sessionId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"open\": true,\n  \"version\": {{sessionVersion}},\n  \"reason\": \"Begin meetup\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"sessionVersion\",data.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove assigned staff",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions/{{sessionId}}/staff",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staffIds\": [],\n  \"version\": {{sessionVersion}},\n  \"reason\": \"End staff assignment\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"sessionVersion\",data.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Restore staff assignment",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions/{{sessionId}}/staff",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staffIds\": [\n    \"{{staffId}}\"\n  ],\n  \"version\": {{sessionVersion}},\n  \"reason\": \"Restore staff assignment\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"sessionVersion\",data.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Close session",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions/{{sessionId}}/state",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"open\": false,\n  \"version\": {{sessionVersion}},\n  \"reason\": \"End meetup\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set(\"sessionVersion\",data.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Read session audit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/sessions/{{sessionId}}/audit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
