{
  "info": {
    "name": "MOE Better Auth local integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only against an isolated local test database. Creates a synthetic member. Never use real passwords or production data. Run order: Signup, Sign in, session, profile, Logout, revoked session. For manual Sign in supply existing test credentials in Body or local environment testPhone/testPassword. Tokens are saved to the selected environment (or collection when none) for separate Send operations. Keep populated values local and do not export/share credentials. Bearer testing disables the cookie jar."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Signup without OTP' && !pm.variables.get('testPhone')) { pm.variables.set('testPhone', '0979' + String(Math.floor(Math.random()*10000000)).padStart(7,'0')); pm.variables.set('testPassword', pm.variables.replaceIn('{{$guid}}')); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Signup without OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"API Test Member\", \"phone\": \"{{testPhone}}\", \"password\": \"{{testPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Signup succeeds without OTP', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.user.role).to.eql('member'); pm.expect(body.token).to.be.a('string'); pm.variables.set('authToken', body.token); if (pm.environment.name) pm.environment.set('authToken', body.token); else pm.collectionVariables.set('authToken', body.token); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "For manual Send, replace phone/password placeholders in Body with an existing test account, or set testPhone/testPassword in a local environment. Runner uses the preceding signup credentials."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sign in succeeds', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.user.phone).to.match(/^\\+95/); pm.variables.set('authToken', body.token); if (pm.environment.name) pm.environment.set('authToken', body.token); else pm.collectionVariables.set('authToken', body.token); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Read mobile session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session is authenticated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.phone).to.match(/^\\+95/); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Read own member profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Own profile is private and provisioned', () => { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.memberNumber).to.match(/^MOE-\\d{6,}$/); pm.expect(body.language).to.eql('en'); pm.expect(Object.keys(body).sort()).to.eql(['language','memberNumber','name','phone','userId']); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Reject revoked session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Revoked session is denied', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Change my password (manual only)",
      "request": {
        "description": "Run manually with an existing authToken and currentPassword/newPassword local variables. All sessions are revoked on success; sign in again. Skip this request in the signup/login/logout smoke runner.",
        "method": "POST",
        "header": [
          {
            "key": "X-MOE-Client",
            "value": "mobile"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/account/password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('currentPassword') || !pm.variables.get('newPassword')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Password changed; sign in again',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().signInRequired).to.eql(true);});"
            ]
          }
        }
      ]
    }
  ]
}
