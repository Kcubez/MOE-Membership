{
  "name": "moe-membership",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev:web": "npm run dev -w @moe/web",
    "dev:api": "npm run dev -w @moe/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @moe/api",
    "db:generate": "npm run db:generate -w @moe/api",
    "db:validate": "npm run db:validate -w @moe/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
