PORT=3000
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon PostgreSQL 15+. Runtime: pooled URL. Schema tooling: direct URL.
DATABASE_URL=
DIRECT_URL=

# Auth uses the same PostgreSQL via Better Auth official Prisma 7 adapter.
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000

# One-time first Admin bootstrap only; remove values after use. Never commit populated values.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional dedicated QR signing key (32+ characters). Keep stable; changing it invalidates all issued QRs.
# If omitted, QR uses a domain-separated key derived from BETTER_AUTH_SECRET.
# QR_SIGNING_SECRET=

# Optional Telegram test bot. Set all three values to enable the integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_URL=
